{
  "info": {
    "name": "My App - Passport JWT + Role Based Auth",
    "description": "Bo API test cho Postman voi 2 luong rieng biet: User va Admin. Co san request cho cac truong hop bi tu choi 401/403 de test thu cong.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userEmail", "value": "" },
    { "key": "userPassword", "value": "123456" },
    { "key": "userToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "otherUserEmail", "value": "" },
    { "key": "otherUserPassword", "value": "123456" },
    { "key": "otherUserToken", "value": "" },
    { "key": "otherUserId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "adminEmail", "value": "admin@yootek.com" },
    { "key": "adminPassword", "value": "123456" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Common",
      "item": [
        {
          "name": "GET /hello",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/hello", "host": ["{{baseUrl}}"], "path": ["hello"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "item": [
            {
              "name": "POST /auth/register - success",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set('userEmail', `user_${Date.now()}@example.com`);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));",
                      "if (res.accessToken) pm.collectionVariables.set('userToken', res.accessToken);",
                      "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);",
                      "if (res.user && res.user.email) pm.collectionVariables.set('userEmail', res.user.email);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Nguyen Van A\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"123456\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
              }
            },
            {
              "name": "POST /auth/register - 400 missing field",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Missing Email\",\n  \"password\": \"123456\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
              }
            },
            {
              "name": "POST /auth/register - 400 invalid email",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Invalid Email\",\n  \"email\": \"abc\",\n  \"password\": \"123456\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
              }
            }
          ]
        },
        {
          "name": "Register Other User",
          "item": [
            {
              "name": "POST /auth/register - other user",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.collectionVariables.set('otherUserEmail', `other_${Date.now()}@example.com`);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 201', () => pm.response.to.have.status(201));",
                      "if (res.accessToken) pm.collectionVariables.set('otherUserToken', res.accessToken);",
                      "if (res.user && res.user.id) pm.collectionVariables.set('otherUserId', res.user.id);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \\\"name\\\": \\\"Other User\\\",\n  \\\"email\\\": \\\"{{otherUserEmail}}\\\",\n  \\\"password\\\": \\\"{{otherUserPassword}}\\\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
              }
            }
          ]
        },
        {
          "name": "Login User",
          "item": [
            {
              "name": "POST /auth/login - success",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "if (res.accessToken) pm.collectionVariables.set('userToken', res.accessToken);",
                      "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);",
                      "if (res.user && res.user.email) pm.collectionVariables.set('userEmail', res.user.email);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              }
            },
            {
              "name": "POST /auth/login - 401 unknown email",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"unknown@example.com\",\n  \"password\": \"123456\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              }
            },
            {
              "name": "POST /auth/login - 401 wrong password",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              }
            }
          ]
        },
        {
          "name": "Me",
          "item": [
            {
              "name": "GET /auth/me - user success",
              "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
              }
            },
            {
              "name": "GET /auth/me - 401 invalid token",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer fake.invalid.token" }],
                "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "item": [
            {
              "name": "POST /auth/login - admin success",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users - User flow",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "GET /users/:id - user can read own profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "GET /users/:id - 404 user cannot read another user",
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/users/{{otherUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{otherUserId}}"]}
          }
        },
        {
          "name": "PUT /users/:id/profile - upsert own profile",

          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Backend intern\",\n  \"avatar\": \"https://example.com/avatar.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "profile"]
            }
          }
        },
        {
          "name": "PUT /users/:id/profile - 404 cannot update another profile",
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]}
          }],
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"bio\": \"Should not be updated\"\n}"},
            "url": {"raw": "{{baseUrl}}/users/{{otherUserId}}/profile", "host": ["{{baseUrl}}"], "path": ["users", "{{otherUserId}}", "profile"]}
          }
        },
        {
          "name": "GET /users - 403 user forbidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "POST /users - 403 user forbidden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Not Allowed\",\n  \"email\": \"forbidden@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "PATCH /users/:id - 403 user forbidden",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "DELETE /users/:id - 403 user forbidden",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Users - Admin flow",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "GET /users - admin list all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "PUT /users/:id/profile - admin can update another profile",
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"]}
