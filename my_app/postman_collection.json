            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"bio\": \"Updated by admin\",\n  \"avatar\": \"https://example.com/admin-avatar.png\"\n}"},
            "url": {"raw": "{{baseUrl}}/users/{{userId}}/profile", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}", "profile"]}
          }
        },
        {
          "name": "PATCH /users/:id - admin update user",
          "request": {
